# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg

# パッケージング成果物（ルート直下のみ。app/lib 等の実装ディレクトリを巻き込まないよう先頭に / を付ける）
/build/
/dist/
/sdist/
/wheels/
/.eggs/

# 仮想環境
venv/
.venv/
env/
ENV/

# 環境変数（秘密情報を含むためコミットしない）
.env
.env.local
.env.*.local

# テスト・型チェック・Lint のキャッシュ
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.cache
.hypothesis/

# カバレッジレポート
htmlcov/
.coverage
.coverage.*
coverage.xml
*.cover

# Node（jsdom 等の検証ツール用。package.json / package-lock.json は追跡する）
node_modules/
npm-debug.log*
yarn-error.log*

# ローカルDB・ログ
*.db
*.sqlite
*.sqlite3
*.log
logs/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# 一時ファイル
*.tmp
*.temp
*.bak

# Claude Code（ADR-001: エージェント/スキル/設定の正本は ~/.claude のみとし、
# プロジェクト側に複製を置かないため、リポジトリでは追跡しない）
.claude/
